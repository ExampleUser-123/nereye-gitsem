# ---- AI Keşif Servisi ----
# V1'de yerel keşif motoru kullanılır (gerçek OSM verisi üzerinden çalışır, uydurma veri üretmez).
# İleride bir LLM sağlayıcısı eklendiğinde burada tanımlanır; anahtar ASLA frontend'e gömülmez,
# proxy backend üzerinden kullanılmalıdır.
VITE_AI_PROVIDER=local

# ---- HEDEFİME NASIL GİDERİM entegrasyonu ----
# Kardeş uygulamanın deep-link şeması (aynı cihazda kuruluysa açılır)
VITE_HEDERIM_SCHEME=hedefimenasilgiderim://navigate

# Uygulama kurulu değilse yönlendirilecek mağaza sayfası (opsiyonel)
# VITE_HEDERIM_PLAY_URL=https://play.google.com/store/apps/details?id=com.hedefimenasilgiderim.app

# Uygulamanın kendi deep-link şeması (ters entegrasyon için)
VITE_APP_SCHEME=nereyegitsem://place
